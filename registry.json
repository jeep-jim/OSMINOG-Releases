{
  "schema": "osminog-release-registry/v2",
  "product": "OSMINOG",
  "sourceRepository": "jeep-jim/OSMINOG",
  "releaseRepository": "jeep-jim/OSMINOG-Releases",
  "platforms": [
    {
      "id": "web-pwa",
      "name": "Web + PWA",
      "channels": {
        "dev": "channels/dev/web-pwa.json",
        "beta": "channels/beta/web-pwa.json",
        "stable": "channels/stable/web-pwa.json"
      }
    },
    {
      "id": "chrome-extension",
      "name": "Chrome extension",
      "channels": {
        "dev": "channels/dev/chrome-extension.json",
        "beta": "channels/beta/chrome-extension.json",
        "stable": "channels/stable/chrome-extension.json"
      }
    },
    {
      "id": "windows",
      "name": "Windows desktop",
      "channels": {
        "dev": "channels/dev/windows.json",
        "beta": "channels/beta/windows.json",
        "stable": "channels/stable/windows.json"
      }
    },
    {
      "id": "macos",
      "name": "macOS desktop",
      "channels": {
        "dev": "channels/dev/macos.json",
        "beta": "channels/beta/macos.json",
        "stable": "channels/stable/macos.json"
      }
    },
    {
      "id": "android",
      "name": "Android mobile application",
      "channels": {
        "dev": "channels/dev/android.json",
        "beta": "channels/beta/android.json",
        "stable": "channels/stable/android.json"
      }
    },
    {
      "id": "ios",
      "name": "iOS mobile application",
      "channels": {
        "dev": "channels/dev/ios.json",
        "beta": "channels/beta/ios.json",
        "stable": "channels/stable/ios.json"
      }
    }
  ],
  "policy": {
    "fullPackagesRequired": true,
    "immutableVersionedArtifacts": true,
    "feedAdvancesAfterRemoteVerification": true,
    "sourceCodeStoredHere": false
  }
}
