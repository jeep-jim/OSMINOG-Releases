    "mouse-631-stress.json": "6.0.31"
  },
  "x-gesture": {
    "file": "mouse-629-swipe-tutorial.json",
    "recognizer": "two-finger-or-wheel",
    "source": "nora-wheel",
    "physicalTrackpadVerified": false,
    "validator": "tools/mouse631-ui-evidence.py",
    "runtimeVersion": "6.0.31",
    "persistenceKey": "mouseDesktopWheelHintV2",
    "sameHintAcrossNativeRestartRequired": true,
    "normalPrivateLearningIsolated": true,
    "savedReportAcceptedAsInput": false
  },
  "x-uiRegressions": {
    "file": "mouse-629-ui-regressions.json",
    "baselineVersion": "6.0.27",
