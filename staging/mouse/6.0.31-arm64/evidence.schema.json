    "separatorScenes": 4,
    "noraThemes": 2,
    "nativeSource": "globalCapture.acquire(display)",
    "exactSeparatorPalette": {
      "light": "#c7cfdf",
      "dark": "#43536b"
    },
    "scrollbarSource": "installed guest WebContents + bundled preload",
    "scrollbarCaptureSource": "guest WebContents.capturePage",
    "scrollbarNativeComposite": false,
    "physicalTrackpadVerified": false,
    "validator": "tools/mouse631-ui-evidence.py",
    "runtimeVersion": "6.0.31",
    "nativeWheelScrolls": 4,
    "trustedScrollEnds": 4,
    "savedReportAcceptedAsInput": false
  },
  "x-noraTransitions": {
